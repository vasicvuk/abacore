// E-Commerce Microservice - Regional Access Policy
// Defines GDPR and data residency compliance rules

// Regional access policy
policy RegionalAccessPolicy {
    apply permitOverrides

    // GDPR compliance - EU users can only be accessed from EU region
    rule EUDataResidency {
        target clause resource.dataRegion == "EU"
        deny
        condition subject.accessRegion != "EU" &&
                  not (subject.role == "admin" && subject.gdprCertified == true)
    }

    // US data locality
    rule USDataLocality {
        target clause resource.dataRegion == "US"
        deny
        condition subject.accessRegion != "US" &&
                  subject.crossRegionApproval != true
    }
}
